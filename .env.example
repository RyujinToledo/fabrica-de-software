# Exemplo de variaveis de ambiente
# Copie para .env antes de rodar localmente e NUNCA commite o arquivo .env
NODE_ENV=development
PORT=3000
# Banco local de desenvolvimento (sem credencial real)
DATABASE_URL=postgresql://app:5432@localhost:5432/fabrica
# Segredo do Better Auth: gere um valor longo e guarde so no .env
BETTER_AUTH_SECRET=
# Origens do painel liberadas no CORS da API (separadas por virgula)
ORIGENS_CONFIADAS=http://127.0.0.1:4173,http://127.0.0.1:5173

# Operador unico local: libera o uso sem login so via loopback.
# Padrao desligado; ligue so no .env local.
OPERADOR_LOCAL=0
