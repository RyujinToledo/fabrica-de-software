{
	"name": "fabrica-de-software",
	"version": "0.1.0",
	"description": "Fábrica de Software Autônoma: transforma ideia em produto pronto com IA, pipeline de 11 fases, TDD, Docker e deploy completo",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:e2e": "playwright test --pass-with-no-tests",
		"db:migrate": "node scripts/db-migrate.js",
		"openapi:gerar": "node --experimental-strip-types scripts/openapi-gerar.ts",
		"security:scan": "gitleaks detect --config .gitleaks.toml --redact -v",
		"security:staged": "gitleaks protect --staged --config .gitleaks.toml --redact -v",
		"security:baseline": "node --experimental-strip-types scripts/verificar-baseline-gitleaks.ts",
		"licencas:auditar": "node --experimental-strip-types scripts/auditoria-licencas.ts",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"better-auth": "^1.7.14",
		"bullmq": "^6.5.2",
		"drizzle-orm": "^0.45.4",
		"ioredis": "^6.0.0",
		"postgres": "^4.0.0",
		"zod": "^4.6.7"
	},
	"keywords": [
		"fabrica-de-software",
		"ai-agents",
		"software-factory",
		"tdd",
		"playwright",
		"vitest",
		"typescript",
		"nodejs",
		"postgresql",
		"rag",
		"bullmq",
		"docker",
		"openapi",
		"zod",
		"better-auth",
		"lgpd",
		"owasp"
	],
	"homepage": "https://github.com/RyujinToledo/fabrica-de-software#readme",
	"bugs": {
		"url": "https://github.com/RyujinToledo/fabrica-de-software/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RyujinToledo/fabrica-de-software.git"
	}
}
