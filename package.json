{
	"name": "fabrica-de-software",
	"version": "0.1.0",
	"description": "Fabrica de software automatizada com gates de seguranca e qualidade",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"security:scan": "gitleaks detect -v",
		"security:staged": "gitleaks protect --staged -v",
		"security:baseline": "node --experimental-strip-types scripts/verificar-baseline-gitleaks.ts",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/node": "^26.6.5",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2"
	}
}
