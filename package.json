{
	"name": "fabrica-de-software",
	"version": "0.1.0",
	"description": "Fabrica de software automatizada com gates de seguranca e qualidade",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:e2e": "playwright test --pass-with-no-tests",
		"db:migrate": "node scripts/db-migrate.js",
		"openapi:gerar": "node --experimental-strip-types scripts/openapi-gerar.ts",
		"security:scan": "gitleaks detect --config .gitleaks.toml --redact -v",
		"security:staged": "gitleaks protect --staged --config .gitleaks.toml --redact -v",
		"security:baseline": "node --experimental-strip-types scripts/verificar-baseline-gitleaks.ts",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"better-auth": "^1.7.14",
		"bullmq": "^6.5.2",
		"drizzle-orm": "^0.45.4",
		"ioredis": "^6.0.0",
		"postgres": "^4.0.0",
		"zod": "^4.6.7"
	}
}
